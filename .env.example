# Postgres (docker-compose default matches this)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_a1?schema=public"

NODE_ENV="development"
APP_URL="http://localhost:5173"
API_PORT="4000"

# OpenRouter (https://openrouter.ai/keys) — never commit a real key
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Default model used when a capability-specific model is not set.
LLM_MODEL="meta-llama/llama-3.1-8b-instruct"

# Optional per-capability overrides — falls back to LLM_MODEL when unset.
EVALUATION_MODEL=""
GENERATION_MODEL=""
CONVERSATION_MODEL=""
