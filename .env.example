# Postgres (docker-compose default matches this)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_a1?schema=public"

NODE_ENV="development"
APP_URL="http://localhost:5173"
API_PORT="4000"

# OpenRouter (https://openrouter.ai/keys) — never commit a real key
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Bootstrap default model — only used until an admin saves AI settings from
# the Admin panel, which then takes over at runtime (no redeploy needed).
LLM_MODEL="meta-llama/llama-3.1-8b-instruct"

# Optional per-capability bootstrap overrides — falls back to LLM_MODEL when unset.
EVALUATION_MODEL=""
CONVERSATION_MODEL=""
ANALYSIS_MODEL=""
