generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseType {
  translation_es_en
  translation_en_es
  fill_blank
  correct_sentence
  free_writing
  paragraph_translation
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ExerciseSource {
  seeded
  ai_generated
}

enum ErrorType {
  grammar
  third_person_singular
  verb_tense
  word_order
  preposition
  article
  pronoun
  possessive
  vocabulary
  expression
  meaning
  spelling
  naturalness
}

enum LLMRequestType {
  evaluation
  generation
  explanation
  conversation
  analysis
}

enum ConversationRole {
  user
  assistant
}

enum AccountRole {
  admin
  user
}

enum GradedBy {
  ai
  rules
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  pinHash      String      @default("")
  role         AccountRole @default(user)
  createdAt    DateTime    @default(now())

  /// The CEFR level this user is currently practicing at. Drives which
  /// exercises loadSelectionData() offers — see apps/api's exercise module.
  currentLevel CefrLevel @default(A1)

  /// Basic brute-force protection on login — see apps/api's auth module.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions         Session[]
  attempts         ExerciseAttempt[]
  skips            ExerciseSkip[]
  conceptProgress  UserConceptProgress[]
  learningSessions LearningSession[]
  conversations    Conversation[]
  llmRequests      LLMRequest[]
  profileAnalyses  ProfileAnalysis[]
}

/// Long-lived login session — a random opaque token, not a JWT, so it can
/// be revoked (logout) by deleting the row. Expiry is extended on use.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Grammar/vocabulary concept, optionally nested under a parent
/// (e.g. "third_person_singular" under "present_simple").
model Concept {
  id       String   @id @default(cuid())
  key      String   @unique
  name     String
  grammarTopic String
  parentId String?
  parent   Concept? @relation("ConceptHierarchy", fields: [parentId], references: [id])
  children Concept[] @relation("ConceptHierarchy")

  exerciseConcepts ExerciseConcept[]
  userProgress     UserConceptProgress[]

  @@index([grammarTopic])
}

model Exercise {
  id             String         @id @default(cuid())
  type           ExerciseType
  level          CefrLevel
  difficulty     Int
  grammarTopic   String
  spanishText    String?
  expectedAnswer String?
  prompt         String?
  contextHint    String?
  source         ExerciseSource @default(seeded)
  createdAt      DateTime       @default(now())

  concepts ExerciseConcept[]
  attempts ExerciseAttempt[]
  skips    ExerciseSkip[]

  @@index([grammarTopic, level, difficulty])
}

model ExerciseConcept {
  exerciseId String
  conceptId  String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([exerciseId, conceptId])
  @@index([conceptId])
}

model ExerciseAttempt {
  id           String    @id @default(cuid())
  userId       String
  exerciseId   String
  rawAnswer    String
  overallScore Float
  createdAt    DateTime  @default(now())

  /// Null for attempts recorded before this field existed — genuinely
  /// unknown, not a guess. Always set for new attempts: "ai" vs "rules"
  /// (crude exact-match fallback) matters for pattern analysis since the
  /// two scoring methods aren't comparably strict.
  gradedBy     GradedBy?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise  Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sentences SentenceResult[]

  @@index([userId, createdAt])
  @@index([exerciseId])
}

model SentenceResult {
  id             String  @id @default(cuid())
  attemptId      String
  sentenceIndex  Int
  text           String
  correct        Boolean
  score          Float

  attempt ExerciseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  errors  Error[]

  @@index([attemptId])
}

model Error {
  id               String    @id @default(cuid())
  sentenceResultId String
  type             ErrorType
  category         String
  explanation      String
  explanationEs    String?
  correctedText    String?

  sentenceResult SentenceResult @relation(fields: [sentenceResultId], references: [id], onDelete: Cascade)

  @@index([sentenceResultId])
  @@index([type, category])
}

/// Audit trail for exercises the learner chose to skip rather than answer —
/// separate from ExerciseAttempt since a skip is explicitly not an attempt
/// and shouldn't affect UserConceptProgress.
model ExerciseSkip {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([exerciseId])
}

model UserConceptProgress {
  id             String    @id @default(cuid())
  userId         String
  conceptId      String
  attempts       Int       @default(0)
  correct        Int       @default(0)
  lastPracticedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId])
}

model LearningSession {
  id                 String    @id @default(cuid())
  userId             String
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  exercisesCompleted Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, startedAt])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ConversationRole
  content        String
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Audit/debug trail for every LLM call — never stores raw prompts/answers,
/// only enough to diagnose cost, latency and failure rate.
model LLMRequest {
  id               String          @id @default(cuid())
  userId           String?
  provider         String
  model            String
  requestType      LLMRequestType
  latencyMs        Int
  success          Boolean
  errorMessage     String?
  promptTokens     Int?
  completionTokens Int?
  /// Computed once at log time from OpenRouter's pricing at that moment —
  /// never recomputed later, so historical numbers don't drift if pricing
  /// changes. Null when the pricing lookup itself failed (best-effort).
  costUsd          Float?
  createdAt        DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestType, createdAt])
  @@index([userId, createdAt])
}

/// Single-row runtime AI configuration, editable from Admin — overrides the
/// LLM_MODEL/*_MODEL env vars without a redeploy. Env vars remain the
/// bootstrap default used only until an admin ever saves a setting here.
model AISettings {
  id                String   @id @default("singleton")
  defaultModel      String
  evaluationModel   String?
  conversationModel String?
  analysisModel     String?
  updatedAt         DateTime @updatedAt
}

/// One on-demand AI (or deterministic-fallback) analysis of a user's
/// practice history — kept as history, not overwritten, so past runs stay
/// visible on the Profile page.
model ProfileAnalysis {
  id          String   @id @default(cuid())
  userId      String
  createdAt   DateTime @default(now())

  /// "ai" for a real model-generated analysis, "rules" for the
  /// deterministic fallback (lowest-accuracy concepts, no narrative).
  gradedBy    GradedBy

  summary     String
  summaryEs   String
  strengths   String[]
  strengthsEs String[]

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreas ProfileAnalysisFocusArea[]

  @@index([userId, createdAt])
}

model ProfileAnalysisFocusArea {
  id         String @id @default(cuid())
  analysisId String
  order      Int
  concept    String
  why        String
  whyEs      String
  howTo      String
  howToEs    String

  analysis ProfileAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}
