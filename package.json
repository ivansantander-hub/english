{
  "name": "english-a1",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @english-a1/web dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @english-a1/api dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "dotenv -e .env -- pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "db:migrate": "dotenv -e .env -- pnpm --filter @english-a1/db exec prisma migrate dev",
    "db:generate": "dotenv -e .env -- pnpm --filter @english-a1/db exec prisma generate",
    "db:seed": "dotenv -e .env -- pnpm --filter @english-a1/db exec tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env -- pnpm --filter @english-a1/db exec prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
